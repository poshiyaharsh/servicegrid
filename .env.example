# ==============================================================================
# FieldSutra (ServiceGrid) — Environment Configuration Template
# Copy this file to .env for local development. NEVER commit .env files.
# ==============================================================================

NODE_ENV=development
APP_NAME=FieldSutra
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info

# PostgreSQL (Primary Database)
POSTGRES_USER=servicegrid
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=servicegrid
DATABASE_URL=postgresql://servicegrid:change_me_local_dev_password@localhost:5432/servicegrid?schema=public

# Redis (Cache & BullMQ Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication & Security (Generate strong random secrets in production)
JWT_ACCESS_SECRET=change_me_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# S3-Compatible Object Storage (MinIO in local dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=fieldsutra-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_change_me

# Error Monitoring & Observability (Optional in local dev)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integration Providers (Sandbox mode by default; configure per provider)
WHATSAPP_PROVIDER=sandbox
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER=sandbox
EMAIL_FROM=noreply@fieldsutra.local
SMS_PROVIDER=sandbox
PAYMENT_PROVIDER=sandbox
MAPS_PROVIDER=sandbox
AI_PROVIDER=disabled
