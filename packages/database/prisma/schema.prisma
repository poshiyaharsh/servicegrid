generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  slug      String   @unique @db.VarChar(80)
  timezone  String   @default("Asia/Kolkata") @db.VarChar(64)
  currency  String   @default("INR") @db.VarChar(8)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches    Branch[]
  users       User[]
  userRoles   UserRole[]
  sessions    Session[]
  invitations OrganizationInvitation[]

  @@map("tenants")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(160)
  code      String   @db.VarChar(32)
  city      String?  @db.VarChar(80)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(160)
  passwordHash    String    @map("password_hash") @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles              UserRole[]
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  resetTokens        PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @db.VarChar(64)
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, role])
  @@index([tenantId])
  @@index([userId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(128)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("password_reset_tokens")
}

model OrganizationInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String    @db.VarChar(255)
  role            String    @db.VarChar(64)
  branchId        String?   @map("branch_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(128)
  invitedByUserId String    @map("invited_by_user_id") @db.Uuid
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("organization_invitations")
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerType String   @default("INDIVIDUAL") @map("customer_type") @db.VarChar(24)
  displayName  String   @map("display_name") @db.VarChar(160)
  companyName  String?  @map("company_name") @db.VarChar(160)
  gstin        String?  @db.VarChar(20)
  primaryPhone String   @map("primary_phone") @db.VarChar(32)
  primaryEmail String?  @map("primary_email") @db.VarChar(255)
  tags         String[] @default([])
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts       CustomerContact[]
  addresses      Address[]
  leads          Lead[]
  conversations  Conversation[]
  activities     CustomerActivity[]
  assets         Asset[]
  serviceHistory ServiceHistory[]

  @@index([tenantId])
  @@index([tenantId, primaryPhone])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String   @db.VarChar(160)
  role       String?  @db.VarChar(80)
  phone      String   @db.VarChar(32)
  email      String?  @db.VarChar(255)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_contacts")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  label      String   @default("Primary") @db.VarChar(64)
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  city       String   @db.VarChar(80)
  state      String   @db.VarChar(80)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country    String   @default("IN") @db.VarChar(8)
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("addresses")
}

model Lead {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  name             String    @db.VarChar(160)
  phone            String    @db.VarChar(32)
  email            String?   @db.VarChar(255)
  source           String    @default("MANUAL") @db.VarChar(48)
  status           String    @default("NEW") @db.VarChar(32)
  notes            String?   @db.Text
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  convertedAt      DateTime? @map("converted_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("leads")
}

model Conversation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  channel         String   @db.VarChar(32)
  direction       String   @db.VarChar(16)
  summary         String   @db.Text
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("conversations")
}

model CustomerActivity {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  activityType String   @map("activity_type") @db.VarChar(64)
  title        String   @db.VarChar(255)
  metadata     Json?
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_activities")
}

model Asset {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  customerId        String    @map("customer_id") @db.Uuid
  name              String    @db.VarChar(160)
  category          String    @db.VarChar(80)
  manufacturer      String?   @db.VarChar(120)
  modelName         String?   @map("model_name") @db.VarChar(120)
  serialNumber      String?   @map("serial_number") @db.VarChar(120)
  installedAt       DateTime? @map("installed_at") @db.Timestamptz(6)
  warrantyExpiresAt DateTime? @map("warranty_expires_at") @db.Timestamptz(6)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceHistory ServiceHistory[]

  @@index([tenantId])
  @@index([customerId])
  @@map("assets")
}

model ServiceHistory {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  assetId        String?  @map("asset_id") @db.Uuid
  summary        String   @db.VarChar(255)
  servicedAt     DateTime @default(now()) @map("serviced_at") @db.Timestamptz(6)
  technicianName String?  @map("technician_name") @db.VarChar(160)
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset    Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@map("service_history")
}

model RequestCategory {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(120)
  code            String   @db.VarChar(40)
  defaultSlaHours Int      @default(24) @map("default_sla_hours")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("request_categories")
}

model ServiceRequest {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  branchId        String?   @map("branch_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  assetId         String?   @map("asset_id") @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  source          String    @default("MANUAL") @db.VarChar(24)
  title           String    @db.VarChar(200)
  description     String    @db.Text
  priority        String    @default("MEDIUM") @db.VarChar(16)
  status          String    @default("NEW") @db.VarChar(24)
  slaDueAt        DateTime? @map("sla_due_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("service_requests")
}

model WorkOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  branchId           String?   @map("branch_id") @db.Uuid
  serviceRequestId   String?   @map("service_request_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  assetId            String?   @map("asset_id") @db.Uuid
  jobNumber          String    @map("job_number") @db.VarChar(40)
  title              String    @db.VarChar(200)
  description        String?   @db.Text
  priority           String    @default("MEDIUM") @db.VarChar(16)
  status             String    @default("NEW") @db.VarChar(24)
  scheduledStartAt   DateTime? @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt     DateTime? @map("scheduled_end_at") @db.Timestamptz(6)
  slaDueAt           DateTime? @map("sla_due_at") @db.Timestamptz(6)
  technicianNotes    String?   @map("technician_notes") @db.Text
  customerApprovedAt DateTime? @map("customer_approved_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason") @db.Text
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments   WorkOrderAssignment[]
  visits        WorkOrderVisit[]
  statusHistory JobStatusHistory[]
  checklists    JobChecklist[]
  reports       JobReport[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  workOrderId      String   @map("work_order_id") @db.Uuid
  technicianUserId String   @map("technician_user_id") @db.Uuid
  isLead           Boolean  @default(false) @map("is_lead")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workOrderId, technicianUserId])
  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_assignments")
}

model WorkOrderVisit {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  workOrderId      String    @map("work_order_id") @db.Uuid
  visitNumber      Int       @map("visit_number")
  scheduledStartAt DateTime? @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt   DateTime? @map("scheduled_end_at") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  status           String    @default("SCHEDULED") @db.VarChar(24)
  notes            String?   @db.Text

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_visits")
}

model JobStatusHistory {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  workOrderId     String   @map("work_order_id") @db.Uuid
  fromStatus      String?  @map("from_status") @db.VarChar(24)
  toStatus        String   @map("to_status") @db.VarChar(24)
  changedByUserId String?  @map("changed_by_user_id") @db.Uuid
  reason          String?  @db.Text
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("job_status_history")
}

model JobChecklist {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  title       String    @db.VarChar(160)
  items       Json
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("checklists")
}

model Attachment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  entityType       String   @map("entity_type") @db.VarChar(48)
  entityId         String   @map("entity_id") @db.Uuid
  category         String   @db.VarChar(32)
  fileName         String   @map("file_name") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  storageKey       String   @map("storage_key") @db.VarChar(255)
  uploadedByUserId String?  @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

model JobReport {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  workOrderId      String   @map("work_order_id") @db.Uuid
  summary          String   @db.Text
  workPerformed    String   @map("work_performed") @db.Text
  customerApproved Boolean  @default(false) @map("customer_approved")
  approvedByName   String?  @map("approved_by_name") @db.VarChar(160)
  generatedAt      DateTime @default(now()) @map("generated_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workOrderId])
  @@map("job_reports")
}

model SyncOperation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  operationId   String   @map("operation_id") @db.VarChar(80)
  userId        String   @map("user_id") @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(48)
  entityId      String   @map("entity_id") @db.Uuid
  action        String   @db.VarChar(48)
  clientVersion Int      @map("client_version")
  status        String   @db.VarChar(24)
  resultPayload Json?    @map("result_payload")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, operationId])
  @@index([tenantId])
  @@map("sync_operations")
}

model Technician {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  displayName  String   @map("display_name") @db.VarChar(160)
  phone        String   @db.VarChar(32)
  homeLat      Decimal? @map("home_lat") @db.Decimal(10, 7)
  homeLng      Decimal? @map("home_lng") @db.Decimal(10, 7)
  workingHours Json     @map("working_hours")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  skills       TechnicianSkill[]
  leaves       TechnicianLeave[]
  appointments Appointment[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("technicians")
}

model TechnicianSkill {
  id               String @id @default(uuid()) @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  technicianId     String @map("technician_id") @db.Uuid
  skillCode        String @map("skill_code") @db.VarChar(64)
  proficiencyLevel Int    @default(1) @map("proficiency_level")

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([tenantId, technicianId, skillCode])
  @@index([tenantId])
  @@map("technician_skills")
}

model TechnicianLeave {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  technicianId String   @map("technician_id") @db.Uuid
  startAt      DateTime @map("start_at") @db.Timestamptz(6)
  endAt        DateTime @map("end_at") @db.Timestamptz(6)
  reason       String?  @db.VarChar(255)
  status       String   @default("APPROVED") @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([technicianId])
  @@map("technician_availability")
}

model Appointment {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
